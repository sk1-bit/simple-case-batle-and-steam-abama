{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HVH.CASES",
  "version": "1.0.0",
  "identifier": "cases.hvh.app",
  "build": {
    "frontendDist": "../../public"
  },
  "app": {
    "windows": [
      {
        "title": "HVH.CASES — Case Simulator",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "shadow": true,
        "center": true,
        "theme": "Dark",
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null,
      "freezePrototype": false,
      "assetProtocol": {
        "enable": false
      }
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "category": "Game",
    "copyright": "© 2025 HVH.CASES",
    "shortDescription": "HVH.CASES Case Simulator",
    "longDescription": "HVH.CASES — Case Simulator с мини-играми Upgrader / Crash / Coinflip, битвами 1v1v1v1, 4 темами и cinematic-режимом.",
    "publisher": "HVH",
    "targets": ["deb", "appimage", "nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "languages": ["English", "Russian"],
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
